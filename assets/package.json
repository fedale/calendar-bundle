{
  "name": "@fedale/calendar-bundle",
  "version": "0.1.0",
  "symfony": {
    "controllers": {
      "now": {
        "main": "controllers/cal-now_controller.js",
        "name": "cal-now",
        "fetch": "lazy",
        "enabled": true
      },
      "button": {
        "main": "controllers/cal-button_controller.js",
        "name": "cal-button",
        "fetch": "lazy",
        "enabled": true
      },
      "interact": {
        "main": "controllers/cal-interact_controller.js",
        "name": "cal-interact",
        "fetch": "eager",
        "enabled": true
      }
    },
    "importmap": {
      "@hotwired/stimulus": "^3.2.2"
    }
  }
}
