{
    "name": "fedale/calendar-bundle",
    "description": "A reusable, server-rendered calendar component for Symfony UX, agnostic of the application domain.",
    "type": "symfony-bundle",
    "keywords": [
        "symfony",
        "bundle",
        "calendar",
        "scheduler",
        "symfony-ux",
        "live-component",
        "stimulus"
    ],
    "license": "MIT",
    "authors": [
        {
            "name": "Danilo Di Moia",
            "email": "zitter@gmail.com"
        }
    ],
    "require": {
        "php": "^8.2",
        "ext-intl": "*",
        "psr/clock": "^1.0",
        "symfony/clock": "^6.4 || ^7.0 || ^8.0",
        "symfony/framework-bundle": "^6.4 || ^7.0 || ^8.0",
        "symfony/translation": "^6.4 || ^7.0 || ^8.0",
        "symfony/stimulus-bundle": "^2.20",
        "symfony/twig-bundle": "^6.4 || ^7.0 || ^8.0",
        "symfony/ux-live-component": "^2.20",
        "symfony/ux-twig-component": "^2.20",
        "twig/twig": "^3.0"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.0",
        "phpstan/phpstan": "^2.0",
        "phpunit/phpunit": "^11.0",
        "symfony/browser-kit": "^6.4 || ^7.0 || ^8.0",
        "symfony/dom-crawler": "^6.4 || ^7.0 || ^8.0",
        "symfony/css-selector": "^6.4 || ^7.0 || ^8.0",
        "symfony/yaml": "^6.4 || ^7.0 || ^8.0"
    },
    "autoload": {
        "psr-4": {
            "Fedale\\CalendarBundle\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Fedale\\CalendarBundle\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "phpstan": "phpstan analyse",
        "test": "phpunit",
        "cs": "php-cs-fixer fix --dry-run --diff",
        "cs-fix": "php-cs-fixer fix"
    },
    "extra": {
        "branch-alias": {
            "dev-main": "0.1.x-dev"
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
